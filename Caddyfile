# mvtteo.fr : le portfolio à la racine, l'outil PowerPoint (service Railway séparé) sous /powerpoint.
# POWERPOINT_UPSTREAM : adresse du service, par défaut son nom sur le réseau privé Railway.

{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	handle /powerpoint* {
		reverse_proxy {$POWERPOINT_UPSTREAM:powerpoint.railway.internal:8080} {
			header_up Host {upstream_hostport}
		}
	}

	handle {
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
